# 网页固定通过 app/api/token/route.ts 获取私有 LiveKit 令牌，无云服务回退。
# WSL 启动脚本会把 LIVEKIT_URL 更新为当前 eth0 地址；密钥须与服务端一致。
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=your-private-key
LIVEKIT_API_SECRET=your-private-secret

# Agent dispatch (https://docs.livekit.io/agents/server/agent-dispatch)
# 与 Python Agent 的命名一致，令牌通过 RoomConfiguration 显式派发。
AGENT_NAME=xiaoya
