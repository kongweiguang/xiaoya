# 私有 LiveKit 服务；console 使用本机音频时不需要这三项。
# devkey/secret 与 livekit-server --dev 一致，仅用于本地调试。
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

VOICE_AGENT_AGENT_NAME=xiaoya
VOICE_AGENT_LANGUAGE=zh

# 可选：SDK 的真实 CPU 配额；须为正有限数，不是放宽过载阈值。
# 无限额 WSL/cgroup v1 根组会按已确认的可用核数自动纠正，其他环境保留 SDK 判断。
# 预热池独立固定为生产 2、开发 0，不随核数扩大；有容器限制时按实际配额填写。
# NUM_CPUS=4

# 可选 MCP 配置；默认没有外部工具，演示服务位于 examples/mcp-demo。
# 自定义服务请复制 mcp.example.json 为被忽略的 mcp.local.json，再修改此路径。
VOICE_AGENT_MCP_CONFIG_FILE=

# 本地 FunASR：WebSocket 逐块 PCM 转写，不提供 HTTP 自动回退。
# 服务地址按实际部署填写；模型固定为当前 Paraformer 流式契约。
VOICE_AGENT_STT_BASE_URL=http://127.0.0.1:8001/v1
VOICE_AGENT_STT_MODEL=paraformer-streaming
VOICE_AGENT_STT_API_KEY=not-required

# DeepSeek：Chat Completions SSE；语音对话显式关闭深度思考。
# 仅支持官方 HTTPS 根地址或 /v1、标准端口，模型固定 deepseek-flash。
VOICE_AGENT_LLM_BASE_URL=https://api.deepseek.com
VOICE_AGENT_LLM_MODEL=deepseek-flash
VOICE_AGENT_LLM_API_KEY=your-deepseek-api-key

# 私有 TTS：POST /v1/audio/speech，返回音频字节。
# 本地 CosyVoice 使用流式 PCM，固定 24kHz 单声道 PCM16。
VOICE_AGENT_TTS_BASE_URL=http://127.0.0.1:8001/v1
VOICE_AGENT_TTS_MODEL=cosyvoice3-0.5b
VOICE_AGENT_TTS_VOICE=default
VOICE_AGENT_TTS_RESPONSE_FORMAT=pcm
VOICE_AGENT_TTS_API_KEY=not-required

# 私有 STT/TTS 无鉴权时必须显式使用 not-required 占位值。
# DeepSeek 必须填写独立密钥；所有客户端均不会读取 OPENAI_API_KEY。

# 可选：覆盖默认助手规则和开场白。
# VOICE_AGENT_INSTRUCTIONS="你是一位友善、可靠的中文语音助手。回复简洁，适合朗读。"
# VOICE_AGENT_GREETING="你好，我是你的语音助手。有什么可以帮你？"
